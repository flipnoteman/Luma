#!/usr/bin/env python3
"""Diff two luma-bench decision logs (W1-U0a).

usage: decisiondiff OLD.jsonl NEW.jsonl [--allow-added-site SITE[,SITE...]] [--strict-locations] [--exact | --ordered | --unordered] [--ignore-case SUBSTR[,...]] [--no-unstable]
       decisiondiff --self-test

The logs come from `LUMA_BENCH_DECISIONS=<path> luma-bench ...` (pinned `LUMA_CALIBRATE=0`,
`LUMA_TELEMETRY=off`, set by the harness). Each case has two passes, `cold` (plan cache empty:
every planning decision) and `warm` (the cache replays: `PlanReplay`), and one `kernels` line (the
launches per kernel label of the harness's profile run). Both passes and the kernels line are
compared per case; the exit status is 1 on any difference.

  --allow-added-site  records of the named sites (the variant name: `ReducePlan`, `Cut`, ...) that NEW
                      has and OLD does not may be added, also in a case where OLD already has records of
                      that site; any other difference fails: a record OLD has that NEW lacks (removed, or
                      changed: the new form is an added record, the old form a removed one) always fails.
  --exact             compare the decisions of a pass as sorted lists, with how often each occurs, and the launch
                      count of every kernel label. By default a pass is the set of its distinct decisions and the
                      kernels are their labels: the repeats of a case that runs many steps per call (replays,
                      launches) follow when the GPU's flushes happen, which differs from run to run.
  --ignore-case       skip the cases whose name contains one of the substrings (cases that batch by the timing
                      of the GPU, e.g. jit/launch/batch100, give a different log from run to run).
  --no-unstable       also compare the cases listed in tools/decisiondiff-unstable.txt, which are skipped by default
                      (each with the reason it is unstable).
  --ordered           like --exact, and in order (threaded cases interleave their threads' decisions).
  --unordered         like --exact for the decisions (sorted lists with counts), and the kernels line as a dict of
                      launch counts per label, compared exactly: a different order of decisions (lazy forcing
                      reorders them) is no difference, any other is. Not combinable with --ordered or --exact.
  --strict-locations  compare file:line:col of locations in luma's own sources too. By default only
                      the file of an internal location (anything outside crates/luma-bench) is
                      compared, since a spec that edits luma moves its lines; the locations of the
                      benchmarks are compared in full.

A case present in only one file is a difference.
"""
import json
import re
import sys
import tempfile
import os
from collections import OrderedDict


ORDERED = False
EXACT = False
UNORDERED = False
IGNORED = []


def site_name(site):
    for i, ch in enumerate(site):
        if ch in "( {":
            return site[:i]
    return site


def norm_location(loc, strict):
    if strict or loc.startswith("crates/luma-bench/"):
        return loc
    return loc.rsplit(":", 2)[0]


def load(path, strict):
    """{case: {"cold": [tuple...], "warm": [tuple...], "kernels": list|None}}"""
    cases = OrderedDict()
    with open(path) as fh:
        for n, line in enumerate(fh, 1):
            line = line.strip()
            if not line.startswith("{"):
                continue
            r = json.loads(line)
            c = cases.setdefault(r["case"], {"cold": [], "warm": [], "kernels": None})
            if "kernels" in r:
                c["kernels"] = r["kernels"]
            else:
                c[r["pass"]].append((r["site"], r["op"], norm_location(r["location"], strict), r["chosen"]))
    return cases


def canon(decisions):
    """The decisions as compared: in order (--ordered), as a sorted list (--exact), else as the set of
    distinct decisions, since how often a case repeats a decision (the replays in one call of a case
    that runs a hundred steps) follows the timing of the GPU's flushes."""
    if ORDERED:
        return list(decisions)
    return sorted(decisions) if EXACT or UNORDERED else sorted(set(decisions))


def canon_kernels(kernels):
    if kernels is None or EXACT:
        return kernels
    if UNORDERED:
        return sorted((k[0], k[1]) for k in kernels)
    # `iterate` picks how many steps one stencil kernel runs from timings of the run: not compared.
    return sorted({re.sub(r"\(\d+ steps", "(N steps", k[0]) for k in kernels})


def load_unstable(path):
    """The case-name substrings of tools/decisiondiff-unstable.txt (`substring<whitespace>reason`, `#` comments)."""
    names = []
    with open(path) as fh:
        for line in fh:
            line = line.strip()
            if line and not line.startswith("#"):
                names.append(line.split(None, 1)[0])
    return names


UNSTABLE_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "decisiondiff-unstable.txt")


def diff(old, new, allowed):
    out = []
    for case in sorted(set(old) | set(new)):
        if any(x in case for x in IGNORED):
            continue
        if case not in new:
            out.append(f"{case}: only in OLD")
            continue
        if case not in old:
            out.append(f"{case}: only in NEW")
            continue
        o, n = old[case], new[case]
        for p in ("cold", "warm"):
            have = set(o[p])
            keep = [d for d in n[p] if site_name(d[0]) not in allowed or d in have]
            if canon(o[p]) != canon(keep):
                out.append(f"{case} [{p}]:")
                out += describe(o[p], keep)
        if canon_kernels(o["kernels"]) != canon_kernels(n["kernels"]):
            out.append(f"{case} [kernels]: {o['kernels']} -> {n['kernels']}")
    return out


def describe(a, b):
    out = []
    i = 0
    while i < max(len(a), len(b)):
        x = a[i] if i < len(a) else None
        y = b[i] if i < len(b) else None
        if x != y:
            out.append(f"  #{i}: - {x}")
            out.append(f"  #{i}: + {y}")
            if len(out) >= 12:
                out.append("  ...")
                break
        i += 1
    return out


def self_test():
    rows = [
        {"case": "jit/a", "pass": "cold", "site": "Coarsen", "op": "add", "location": "crates/luma-bench/src/x.rs:10:5", "chosen": "coarsen 4"},
        {"case": "jit/a", "pass": "cold", "site": "Cut(Nodes { nodes: 17, limit: 16 })", "op": "mul", "location": "crates/luma-bench/src/x.rs:11:5", "chosen": "nodes 17>16"},
        {"case": "jit/a", "pass": "warm", "site": "PlanReplay", "op": "add", "location": "crates/luma-bench/src/x.rs:10:5", "chosen": "replay"},
        {"case": "jit/a", "kernels": [["k", 2]]},
    ]
    d = tempfile.mkdtemp()

    def write(name, rs):
        p = os.path.join(d, name)
        with open(p, "w") as fh:
            for r in rs:
                fh.write(json.dumps(r) + "\n")
        return p

    a, b = write("a", rows), write("b", rows)
    assert not diff(load(a, False), load(b, False), set()), "identical logs must diff clean"
    changed = [dict(r) for r in rows]
    changed[0]["chosen"] = "coarsen 2"
    c = write("c", changed)
    assert diff(load(a, False), load(c, False), set()), "a changed label must differ"
    added = rows + [{"case": "jit/a", "pass": "cold", "site": "ReducePlan", "op": "sum", "location": "src/reduce.rs:1:1", "chosen": "x"}]
    e = write("e", added)
    assert diff(load(a, False), load(e, False), set()), "an added site must differ"
    assert not diff(load(a, False), load(e, False), {"ReducePlan"}), "an allowed added site must not"
    assert diff(load(e, False), load(a, False), {"ReducePlan"}), "a removed site must differ"
    # An added record of an allowed site is forgiven in a case that already has some; a removed or
    # changed one is not, and neither is an added record of another site.
    more = added + [dict(added[-1], op="prod", chosen="y")]
    e2 = write("e2", more)
    assert not diff(load(e, False), load(e2, False), {"ReducePlan"}), "an added record of a site the case has is forgiven"
    assert diff(load(e, False), load(e2, False), set()), "... only when the site is allowed"
    assert diff(load(e2, False), load(e, False), {"ReducePlan"}), "a removed record of an allowed site differs"
    chg = [dict(r) for r in added]
    chg[-1]["chosen"] = "z"
    e3 = write("e3", chg)
    assert diff(load(e, False), load(e3, False), {"ReducePlan"}), "a changed record of an allowed site differs"
    other = added + [dict(added[-1], site="Cut(Nodes { nodes: 1, limit: 2 })")]
    e4 = write("e4", other)
    assert diff(load(e, False), load(e4, False), {"ReducePlan"}), "an added record of another site differs"
    moved = [dict(r) for r in rows]
    moved[1]["location"] = "src/jit/mod.rs:5:5"
    moved2 = [dict(r) for r in rows]
    moved2[1]["location"] = "src/jit/mod.rs:9:5"
    m1, m2 = write("m1", moved), write("m2", moved2)
    assert not diff(load(m1, False), load(m2, False), set()), "internal line numbers are not compared"
    assert diff(load(m1, True), load(m2, True), set()), "--strict-locations compares them"
    global EXACT, ORDERED
    twice = rows + [rows[2]]
    t = write("t", twice)
    assert not diff(load(a, False), load(t, False), set()), "repeats are not compared by default"
    EXACT = True
    assert diff(load(a, False), load(t, False), set()), "--exact compares them"
    EXACT = False
    global UNORDERED
    swapped = [rows[1], rows[0], rows[2], rows[3]]
    sw = write("sw", swapped)
    kswap = write("ks", rows[:3] + [{"case": "jit/a", "kernels": [["k", 3]]}])
    missing = write("ms", rows[:1] + rows[2:])
    assert not diff(load(a, False), load(sw, False), set()), "an order change is no difference by default"
    UNORDERED = True
    assert not diff(load(a, False), load(sw, False), set()), "--unordered ignores the order"
    assert diff(load(a, False), load(missing, False), set()), "--unordered: a missing decision differs"
    assert diff(load(a, False), load(kswap, False), set()), "--unordered: a kernel count differs"
    assert diff(load(a, False), load(t, False), set()), "--unordered compares repeats"
    UNORDERED = False
    ORDERED = True
    assert diff(load(a, False), load(sw, False), set()), "--ordered: an order change differs"
    ORDERED = False
    # The unstable list: parsed with its reasons, and a listed case does not fail a diff.
    listed = os.path.join(tempfile.mkdtemp(), "unstable.txt")
    with open(listed, "w") as fh:
        fh.write("# comment\njit/launch/batch100\tflush timing\n")
    names = load_unstable(listed)
    assert names == ["jit/launch/batch100"] and all(" " not in n for n in names), names
    flaky = [dict(r, case=names[0] + "_n1") for r in rows]
    flaky2 = [dict(r, chosen="coarsen 2") if r.get("pass") == "cold" else dict(r) for r in flaky]
    f1, f2 = write("f1", flaky), write("f2", flaky2)
    assert diff(load(f1, False), load(f2, False), set()), "a changed case differs"
    IGNORED.extend(names)
    assert not diff(load(f1, False), load(f2, False), set()), "a listed unstable case is skipped"
    IGNORED.clear()
    print("decisiondiff self-test: ok")


def main(argv):
    if argv and argv[0] == "--self-test":
        self_test()
        return 0
    pos, allowed, strict, unstable = [], set(), False, True
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--allow-added-site":
            i += 1
            allowed |= {s for s in argv[i].split(",") if s}
        elif a == "--ignore-case":
            i += 1
            IGNORED.extend(x for x in argv[i].split(",") if x)
        elif a == "--no-unstable":
            unstable = False
        elif a == "--exact":
            global EXACT
            EXACT = True
        elif a == "--ordered":
            global ORDERED
            ORDERED = True
        elif a == "--unordered":
            global UNORDERED
            UNORDERED = True
        elif a == "--strict-locations":
            strict = True
        elif a in ("-h", "--help"):
            print(__doc__)
            return 0
        else:
            pos.append(a)
        i += 1
    if UNORDERED and (ORDERED or EXACT):
        print("decisiondiff: --unordered cannot be combined with --ordered or --exact", file=sys.stderr)
        return 2
    if len(pos) != 2:
        print(__doc__, file=sys.stderr)
        return 2
    if unstable:
        IGNORED.extend(load_unstable(UNSTABLE_FILE))
    out = diff(load(pos[0], strict), load(pos[1], strict), allowed)
    for line in out:
        print(line)
    if out:
        print(f"decisiondiff: {len([l for l in out if not l.startswith('  ')])} difference(s)")
        return 1
    print("decisiondiff: identical")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
