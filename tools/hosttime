#!/usr/bin/env python3
"""hosttime: per-iteration host instructions of luma-bench cases, by callgrind (W0 part C).

  tools/hosttime [--backend cpu|cuda] [--case SUITE/CASE]... [--iters-a 100] [--iters-b 600]
                 [--binary PATH] [--plan-cache on|off] [--out FILE.json] [--top N]
  tools/hosttime --compare BASE.json NEW.json [--max-regression PCT]

Runs each case of the release `luma-bench` binary under `valgrind --tool=callgrind` twice, with
`--iters A` and `--iters B` timed calls, and prints (Ir_B - Ir_A) / (B - A): the instructions of one
iteration, so start-up, calibration probes and the case's one-off verification cancel. Reported per case:

  total       all instructions of the process
  luma_self   instructions executed in functions of the `luma` crates (`luma::`, `luma_core::`, ...):
              their self cost, so nothing is counted twice; this is the "instructions inside luma::" gate
  top         the functions of those crates with the largest inclusive per-iteration cost

The environment is pinned: fresh LUMA_CACHE_DIR, LUMA_CALIBRATE=0, LUMA_TELEMETRY=off, the plan cache on
(`--plan-cache off` sets LUMA_PLAN_CACHE=off) and one CPU worker thread (LUMA_CPU_THREADS=1, unless already
set) so counts are deterministic. `luma_self` is the gate metric (repeatable to ~0.001%); `total` also counts the
allocator, libc and background threads and varies ~0.2% between runs, so it is informational. Results are JSON; `--compare` prints the ratio per case and exits 1 if
any case's luma_self grows by more than --max-regression percent (default 1.0).

Needs valgrind (the 3090 box through gpuq has it; the CPU backend works anywhere). Run `cargo build
--release -p luma-bench` first or let this script do it (no --binary).
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
# Rust symbols of the library crates: luma::..., luma_core::..., luma_cpu::..., <luma::T as ...>::f (not luma_bench)
LIB_FN = re.compile(r"^(?:<)*(luma(?:_(?!bench)[a-z0-9]+)*)::")
LINE = re.compile(r"^\s*([\d,]+)\s+\(\s*[\d.]+%\)\s+(.*)$")


def annotate(path, inclusive):
    """{function: Ir} from callgrind_annotate (self cost, or inclusive)."""
    cmd = ["callgrind_annotate", "--threshold=100", f"--inclusive={'yes' if inclusive else 'no'}", path]
    out = subprocess.run(cmd, capture_output=True, text=True, check=True).stdout
    funcs = {}
    for line in out.splitlines():
        m = LINE.match(line)
        if not m:
            continue
        ir, name = int(m.group(1).replace(",", "")), m.group(2)
        # "???:luma::jit::create [binary]" / "path/file.c:func [lib]": drop the file prefix and the object
        name = re.sub(r"^[^\s:<]*:(?!:)", "", name, count=1)
        name = re.sub(r"\s+\[[^\]]*\]$", "", name)
        funcs[name] = funcs.get(name, 0) + ir
    return funcs


def totals(path):
    out = subprocess.run(["callgrind_annotate", path], capture_output=True, text=True, check=True).stdout
    for line in out.splitlines():
        if "PROGRAM TOTALS" in line:
            m = re.match(r"^\s*([\d,]+)", line)
            if m:
                return int(m.group(1).replace(",", ""))
    for line in open(path):  # the data file's own summary line
        if line.startswith(("summary:", "totals:")):
            return int(line.split(":")[1].split()[0])
    raise SystemExit(f"no program total in {path}")


def run_once(binary, backend, case, iters, plan_cache, workdir):
    out = os.path.join(workdir, f"cg.{iters}")
    for f in os.listdir(workdir):
        if f.startswith(f"cg.{iters}"):
            os.remove(os.path.join(workdir, f))
    env = dict(os.environ)
    env.update(
        LUMA_BACKEND=backend,
        LUMA_CACHE_DIR=tempfile.mkdtemp(dir=workdir),
        LUMA_CALIBRATE="0",
        LUMA_TELEMETRY="off",
    )
    env.setdefault("LUMA_CPU_THREADS", "1")
    if plan_cache == "off":
        env["LUMA_PLAN_CACHE"] = "off"
    else:
        env.pop("LUMA_PLAN_CACHE", None)
    cmd = ["valgrind", "--tool=callgrind", f"--callgrind-out-file={out}", binary, "--only", case, "--iters", str(iters)]
    r = subprocess.run(cmd, env=env, capture_output=True, text=True)
    if r.returncode != 0 or case.split("/", 1)[-1] not in r.stdout:
        sys.stderr.write(r.stdout[-2000:] + r.stderr[-2000:])
        raise SystemExit(f"hosttime: {case} failed under callgrind (exit {r.returncode}); is it a case name?")
    return out


def measure(binary, backend, case, a, b, plan_cache, top):
    with tempfile.TemporaryDirectory(prefix="hosttime.") as work:
        files = {n: run_once(binary, backend, case, n, plan_cache, work) for n in (a, b)}
        total = {n: totals(files[n]) for n in files}
        incl = {n: annotate(files[n], True) for n in files}
        selfc = {n: annotate(files[n], False) for n in files}
    d = b - a

    def luma_self(s):
        return sum(v for k, v in s.items() if LIB_FN.match(k))

    funcs = {}
    for name, v in incl[b].items():
        if LIB_FN.match(name) and name in incl[a]:
            per = (v - incl[a][name]) / d
            if per > 0:
                funcs[name] = per
    best = dict(sorted(funcs.items(), key=lambda kv: -kv[1])[:top])
    return {
        "case": case,
        "backend": backend,
        "plan_cache": plan_cache,
        "iters": [a, b],
        "total": (total[b] - total[a]) / d,
        "luma_self": (luma_self(selfc[b]) - luma_self(selfc[a])) / d,
        "top": best,
    }


def build():
    subprocess.run(["cargo", "build", "--release", "-q", "-p", "luma-bench"], cwd=ROOT, check=True)
    target = os.environ.get("CARGO_TARGET_DIR") or os.path.join(ROOT, "target")
    return os.path.join(target, "release", "luma-bench")


def compare(base_path, new_path, max_pct):
    base = {(r["case"], r["backend"], r["plan_cache"]): r for r in json.load(open(base_path))}
    new = {(r["case"], r["backend"], r["plan_cache"]): r for r in json.load(open(new_path))}
    bad = False
    print(f"{'case':<44} {'backend':<7} {'metric':<10} {'base':>14} {'new':>14} {'ratio':>8}")
    for key in sorted(base.keys() | new.keys()):
        if key not in base or key not in new:
            print(f"{key[0]:<44} {key[1]:<7} only in {'base' if key in base else 'new'}")
            continue
        for metric in ("luma_self", "total"):
            x, y = base[key][metric], new[key][metric]
            ratio = y / x if x else float("inf")
            flag = ""
            if metric == "luma_self" and (ratio - 1.0) * 100.0 > max_pct:
                flag, bad = "  REGRESSION", True
            print(f"{key[0]:<44} {key[1]:<7} {metric:<10} {x:>14,.0f} {y:>14,.0f} {ratio:>8.4f}{flag}")
    return 1 if bad else 0


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--backend", default="cpu", choices=["cpu", "cuda", "wgpu", "metal"])
    p.add_argument("--case", action="append", default=[], metavar="SUITE/CASE")
    p.add_argument("--iters-a", type=int, default=100)
    p.add_argument("--iters-b", type=int, default=600)
    p.add_argument("--binary")
    p.add_argument("--plan-cache", default="on", choices=["on", "off"])
    p.add_argument("--out", help="write the JSON results here (default: stdout summary only)")
    p.add_argument("--top", type=int, default=12, help="functions listed per case")
    p.add_argument("--compare", nargs=2, metavar=("BASE", "NEW"))
    p.add_argument("--max-regression", type=float, default=1.0, metavar="PCT")
    a = p.parse_args()
    if a.compare:
        sys.exit(compare(a.compare[0], a.compare[1], a.max_regression))
    if not a.case:
        p.error("give at least one --case SUITE/CASE")
    if a.iters_b <= a.iters_a:
        p.error("--iters-b must exceed --iters-a")
    for tool in ("valgrind", "callgrind_annotate"):
        if not shutil.which(tool):
            sys.exit(f"hosttime: {tool} not found")
    binary = a.binary or build()
    results = []
    for case in a.case:
        r = measure(binary, a.backend, case, a.iters_a, a.iters_b, a.plan_cache, a.top)
        results.append(r)
        print(f"## {case} [{a.backend}, plan cache {a.plan_cache}]: per-iteration Ir ({a.iters_b}-{a.iters_a})/{a.iters_b - a.iters_a}")
        print(f"{r['total']:>14,.0f}  total")
        print(f"{r['luma_self']:>14,.0f}  luma_self (self cost of luma* functions)")
        for name, v in r["top"].items():
            print(f"{v:>14,.0f}  {name[:150]}")
    if a.out:
        with open(a.out, "w") as fh:
            json.dump(results, fh, indent=1)
            fh.write("\n")


if __name__ == "__main__":
    main()
